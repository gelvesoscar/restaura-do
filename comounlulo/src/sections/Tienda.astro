---
import SectionHead from "../components/SectionHead.astro";
import Photo from "../components/Photo.astro";
import Card from "../components/Card.astro";
import Input from "../components/Input.astro";
import Checkbox from "../components/Checkbox.astro";
import Button from "../components/Button.astro";
import Icon from "../components/Icon.astro";
---

<section id="tienda" class="tienda">
  <div class="tienda-inner">
    <div class="tienda-grid">
      <div class="tienda-photo">
        <Photo
          label="Lulos recién escogidos en el mercado"
          ratio="4 / 5"
          tone="flat"
          src="/images/lulo-mercado.jpg"
        />
      </div>

      <div class="tienda-info">
        <SectionHead
          eyebrow="Tienda"
          title="Muy pronto vas a poder llevarte comounlulo a tu mesa."
          lead="Todavía estamos probando cuál va a ser la primera forma real de hacerlo. Antes de anunciar nada, queremos estar seguros de poder cumplirlo. Déjanos tu correo y sé de los primeros en enterarte, sin ningún compromiso de compra."
        />

        <Card elevation="sm" class="tienda-card">
          <form id="reserva-form" class="reserva-form">
            <Input
              label="Correo"
              type="email"
              name="correo"
              id="reserva-correo"
              placeholder="tu@correo.co"
              hint="Ahí te escribimos apenas tengamos algo real que contar."
              required
            />
            <Checkbox
              label="Acepto que me escriban sobre el lanzamiento"
              name="consentimiento"
            />
            <p id="reserva-error" class="reserva-error" hidden>
              Marca la casilla de arriba para poder anotarte.
            </p>
            <p class="reserva-legal">
              Anotarte no tiene costo ni es un compromiso de compra. Ver <a href="/privacidad">política de privacidad</a>.
            </p>
            <Button size="lg" class="reserva-btn">Anotarme en la lista de espera</Button>
          </form>

          <div id="reserva-exito" class="reserva-exito" hidden>
            <Icon name="check" size={18} color="var(--text-link-hover)" />
            <p>Revisa tu correo: te enviamos un mensaje para confirmar tu anotación. Una vez confirmes, quedas en la lista, y te escribimos apenas tengamos novedades reales.</p>
          </div>

          <div class="tienda-entrega">
            <Icon name="truck" size={16} color="var(--text-muted)" />
            No hay producto, precio ni fecha confirmados todavía. Anotarte no es un pedido, es decirnos que te
            interesa lo que viene.
          </div>
        </Card>
      </div>
    </div>
  </div>
</section>

<style>
  .tienda {
    background: var(--surface-card);
    border-top: 1px solid var(--border-hairline);
    scroll-margin-top: 72px;
  }
  .tienda-inner {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--section-y) var(--gutter-page);
  }
  .tienda-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16);
    align-items: center;
  }
  .tienda-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .tienda-card {
    gap: var(--space-4) !important;
  }
  /* Sin :not([hidden]) aqui, esta regla le gana en especificidad a la
     regla nativa `[hidden]{display:none}` del navegador y el formulario
     nunca se oculta de verdad tras `form.hidden = true` (mismo bug ya
     documentado en .bolsa-dialog[open] mas abajo en el historial del
     proyecto). */
  .reserva-form:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .reserva-error {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-link-hover);
  }
  .reserva-legal {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-muted);
    line-height: var(--lh-body);
  }
  .reserva-legal a {
    color: var(--text-link);
  }
  .reserva-btn {
    width: 100%;
  }
  /* Mismo motivo que .reserva-form: sin :not([hidden]) el bloque de
     exito quedaria visible siempre, incluso antes de enviar el
     formulario. */
  .reserva-exito:not([hidden]) {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    background: var(--brand-tint);
    border-radius: var(--radius-md);
    padding: var(--space-4);
  }
  .reserva-exito p {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    color: var(--text-strong);
    line-height: var(--lh-body);
  }
  .tienda-entrega {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    color: var(--text-muted);
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    line-height: var(--lh-body);
  }
  .tienda-entrega :global(span[aria-hidden]) {
    margin-top: 2px;
  }
  @media (max-width: 900px) {
    .tienda-grid {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }
  }
</style>

<script>
  import { anotarseEnListaDeEspera } from "../lib/waitlist";

  const form = document.getElementById("reserva-form") as HTMLFormElement | null;
  const exito = document.getElementById("reserva-exito");
  const error = document.getElementById("reserva-error");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    const data = new FormData(form);
    const correo = String(data.get("correo") ?? "");
    const consentimiento = data.get("consentimiento");

    if (!consentimiento) {
      if (error) error.hidden = false;
      const checkbox = form.querySelector<HTMLInputElement>('input[name="consentimiento"]');
      checkbox?.focus();
      return;
    }

    if (error) error.hidden = true;
    await anotarseEnListaDeEspera({ correo, color: "" });
    form.hidden = true;
    if (exito) exito.hidden = false;
  });
</script>
