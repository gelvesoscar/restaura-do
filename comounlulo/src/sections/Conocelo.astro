---
import { getCollection } from "astro:content";
import SectionHead from "../components/SectionHead.astro";
import Icon from "../components/Icon.astro";

const temasRaw = await getCollection("conocelo");
const temas = temasRaw.sort((a, b) => a.data.order - b.data.order);

function badgeTipo(tipo: string) {
  if (tipo.startsWith("Ciencia") || tipo === "Biblioteca viva") return "Ciencia";
  if (tipo.startsWith("Nutrición")) return "Nutrición";
  if (tipo.startsWith("Hábitos")) return "Hábitos";
  if (tipo.startsWith("Mitos")) return "Mitos";
  if (tipo.startsWith("Origen") || tipo.startsWith("Circularidad")) return "Origen";
  return tipo;
}

function slug(s: string) {
  return s
    .normalize("NFD")
    .replace(/\p{Diacritic}/gu, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-");
}

const CATEGORIAS = ["Origen", "Mitos", "Ciencia", "Nutrición", "Hábitos"];

const grupos = CATEGORIAS.map((cat) => ({
  cat,
  items: temas.filter((t) => badgeTipo(t.data.tipo) === cat),
})).filter((g) => g.items.length > 0);

// Orden por categoría (Origen, Mitos, Ciencia, Nutrición, Hábitos) para la
// vista "Todos", en vez del orden numérico S01..S12.
const temasOrdenados = grupos.flatMap((g) => g.items);

// Mismos datos, dos maquetados distintos según el ancho de pantalla (uno se
// oculta con CSS y el otro se muestra, ver .conocelo-acordeon--mobile /
// --desktop más abajo):
//
// - Móvil: acordeón lineal clásico. Encabezado y panel son vecinos directos
//   en el documento, así que al abrir uno, su contenido aparece justo debajo
//   y empuja al resto hacia abajo, sin dejar huecos.
// - Escritorio: menú de categorías compacto a la izquierda y un panel de
//   contenido aparte a la derecha que solo muestra la categoría activa. Al
//   ser dos columnas independientes (no filas emparejadas), abrir una
//   categoría con muchos artículos no estira ni desordena la lista de la
//   izquierda. Dentro del panel de contenido, los artículos además se
//   acomodan en varias columnas (grid) para aprovechar el ancho disponible
//   en vez de quedar en una sola lista angosta con espacio vacío al lado.
//
// Se generan IDs únicos por variante (prefijo m- / d-) porque ambos bloques
// existen a la vez en el HTML (uno queda en display:none según el ancho).
const acordeon = [
  { cat: "Todos", items: temasOrdenados, abierto: true },
  ...grupos.map((g) => ({ cat: g.cat, items: g.items, abierto: false })),
];
---

<section id="conocelo" class="conocelo">
  <div class="conocelo-inner">
    <SectionHead
      eyebrow="Ciencia"
      title="Conócelo."
      lead="12 notas sobre la ciencia real del lulo, con fuente citada y sin promesas de más."
    />

    {/* Móvil: acordeón lineal (encabezado + panel intercalados). */}
    <div class="conocelo-acordeon conocelo-acordeon--mobile">
      {
        acordeon.map(({ cat, items, abierto }) => {
          const headerId = `conocelo-header-m-${slug(cat)}`;
          const panelId = `conocelo-panel-m-${slug(cat)}`;
          return (
            <>
              <button
                type="button"
                id={headerId}
                class="conocelo-item-header"
                data-accordion-trigger
                aria-expanded={abierto ? "true" : "false"}
                aria-controls={panelId}
              >
                <span class="conocelo-item-label">{cat}</span>
                <span class="conocelo-item-count">{items.length}</span>
                <span class="conocelo-item-chevron">
                  <Icon name="chevron-down" size={16} />
                </span>
              </button>
              <div
                id={panelId}
                class="conocelo-item-panel"
                role="region"
                aria-labelledby={headerId}
                hidden={!abierto}
              >
                <div class="conocelo-item-list">
                  {items.map((t) => {
                    const d = t.data;
                    const tcat = badgeTipo(d.tipo);
                    return (
                      <a href={`/conocelo/${t.id}`} class="conocelo-row">
                        <span class="conocelo-row-thumb">
                          <img src={d.imagen} alt={d.alt} loading="lazy" />
                        </span>
                        <span class="conocelo-row-body">
                          <span class="conocelo-row-title">{d.title}</span>
                          <span class="conocelo-row-meta">{tcat}</span>
                        </span>
                      </a>
                    );
                  })}
                </div>
              </div>
            </>
          );
        })
      }
    </div>

    {/* Escritorio: menú compacto a la izquierda + panel de contenido aparte
       a la derecha (dos columnas independientes, no filas emparejadas). */}
    <div class="conocelo-acordeon conocelo-acordeon--desktop">
      <div class="conocelo-menu">
        {
          acordeon.map(({ cat, items, abierto }) => {
            const headerId = `conocelo-header-d-${slug(cat)}`;
            const panelId = `conocelo-panel-d-${slug(cat)}`;
            return (
              <button
                type="button"
                id={headerId}
                class="conocelo-item-header"
                data-accordion-trigger
                aria-expanded={abierto ? "true" : "false"}
                aria-controls={panelId}
              >
                <span class="conocelo-item-label">{cat}</span>
                <span class="conocelo-item-count">{items.length}</span>
                <span class="conocelo-item-chevron">
                  <Icon name="chevron-down" size={16} />
                </span>
              </button>
            );
          })
        }
      </div>
      <div class="conocelo-content">
        {
          acordeon.map(({ cat, items, abierto }) => {
            const headerId = `conocelo-header-d-${slug(cat)}`;
            const panelId = `conocelo-panel-d-${slug(cat)}`;
            return (
              <div
                id={panelId}
                class="conocelo-item-panel"
                role="region"
                aria-labelledby={headerId}
                hidden={!abierto}
              >
                <div class="conocelo-item-list">
                  {items.map((t) => {
                    const d = t.data;
                    const tcat = badgeTipo(d.tipo);
                    return (
                      <a href={`/conocelo/${t.id}`} class="conocelo-row">
                        <span class="conocelo-row-thumb">
                          <img src={d.imagen} alt={d.alt} loading="lazy" />
                        </span>
                        <span class="conocelo-row-body">
                          <span class="conocelo-row-title">{d.title}</span>
                          <span class="conocelo-row-meta">{tcat}</span>
                        </span>
                      </a>
                    );
                  })}
                </div>
              </div>
            );
          })
        }
      </div>
    </div>

    <p class="conocelo-nota">
      Estas notas describen ciencia nutricional y hábitos cotidianos. No
      diagnostican, no tratan ni curan condiciones, y no sustituyen la
      orientación de un profesional de la salud.
    </p>
  </div>
</section>

<style>
  .conocelo {
    scroll-margin-top: 72px;
  }
  .conocelo-inner {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--section-y) var(--gutter-page);
  }

  .conocelo-acordeon--desktop {
    display: none;
  }
  .conocelo-acordeon--mobile {
    display: grid;
    grid-template-columns: 1fr;
    margin-bottom: var(--space-6);
  }

  .conocelo-item-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-3) 0;
    border: none;
    border-bottom: 1px solid var(--border-default);
    background: none;
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    color: var(--text-strong);
    cursor: pointer;
    transition: var(--transition-base);
  }
  .conocelo-item-header:hover {
    color: var(--brand);
  }
  .conocelo-item-header[aria-expanded="true"] {
    border-color: var(--brand);
    color: var(--brand);
  }
  .conocelo-item-label {
    flex: 1;
    text-align: left;
    font-weight: var(--fw-medium);
  }
  .conocelo-item-count {
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    opacity: 0.65;
  }
  .conocelo-item-chevron {
    display: inline-flex;
    transition: var(--transition-base);
  }
  .conocelo-item-header[aria-expanded="true"] .conocelo-item-chevron {
    transform: rotate(180deg);
  }

  .conocelo-item-panel {
    padding: var(--space-3) 0 var(--space-4) var(--space-4);
  }
  .conocelo-item-panel[hidden] {
    display: none;
  }
  .conocelo-item-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .conocelo-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: var(--transition-base);
  }
  .conocelo-row:hover {
    background: var(--cream-200);
  }
  .conocelo-row-thumb {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--gradient-lulo);
  }
  .conocelo-row-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .conocelo-row-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .conocelo-row-title {
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    color: var(--text-strong);
    line-height: var(--lh-body);
  }
  .conocelo-row-meta {
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow);
  }

  .conocelo-nota {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-muted);
    max-width: 70ch;
    margin: 0;
  }

  @media (min-width: 761px) {
    .conocelo-acordeon--mobile {
      display: none;
    }
    .conocelo-acordeon--desktop {
      display: flex;
      align-items: flex-start;
      gap: var(--space-6);
      margin-bottom: var(--space-6);
    }
    .conocelo-menu {
      flex: 0 0 260px;
      display: flex;
      flex-direction: column;
    }
    .conocelo-content {
      flex: 1;
      min-width: 0;
    }
    .conocelo-content .conocelo-item-panel {
      padding: 0;
    }
    /* En el panel de escritorio hay más ancho disponible que en el móvil,
       así que las filas compactas se acomodan en varias columnas (en vez de
       una sola lista angosta) para aprovechar ese espacio. */
    .conocelo-content .conocelo-item-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: var(--space-1) var(--space-4);
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("#conocelo .conocelo-acordeon").forEach((container) => {
    const triggers = Array.from(
      container.querySelectorAll<HTMLButtonElement>("[data-accordion-trigger]"),
    );

    function closeAll() {
      triggers.forEach((h) => {
        h.setAttribute("aria-expanded", "false");
        const panel = document.getElementById(h.getAttribute("aria-controls") ?? "");
        if (panel) panel.hidden = true;
      });
    }

    triggers.forEach((header) => {
      header.addEventListener("click", () => {
        const wasOpen = header.getAttribute("aria-expanded") === "true";
        const panel = document.getElementById(header.getAttribute("aria-controls") ?? "");
        closeAll();
        if (!wasOpen) {
          header.setAttribute("aria-expanded", "true");
          if (panel) panel.hidden = false;
        }
      });
    });
  });
</script>
