---
import { getCollection } from "astro:content";
import SectionHead from "../components/SectionHead.astro";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";

const temasRaw = await getCollection("conocelo");
const temas = temasRaw.sort((a, b) => a.data.order - b.data.order);

function badgeTipo(tipo: string) {
  if (tipo.startsWith("Ciencia") || tipo === "Biblioteca viva") return "Ciencia";
  if (tipo.startsWith("Nutrición")) return "Nutrición";
  if (tipo.startsWith("Hábitos")) return "Hábitos";
  if (tipo.startsWith("Mitos")) return "Mitos";
  if (tipo.startsWith("Origen") || tipo.startsWith("Circularidad")) return "Origen";
  return tipo;
}

function slug(s: string) {
  return s
    .normalize("NFD")
    .replace(/\p{Diacritic}/gu, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-");
}

const CATEGORIAS = ["Origen", "Mitos", "Ciencia", "Nutrición", "Hábitos"];

const grupos = CATEGORIAS.map((cat) => ({
  cat,
  items: temas.filter((t) => badgeTipo(t.data.tipo) === cat),
})).filter((g) => g.items.length > 0);

// Orden por categoría (Origen, Mitos, Ciencia, Nutrición, Hábitos) para la
// vista "Todos", en vez del orden numérico S01..S12.
const temasOrdenados = grupos.flatMap((g) => g.items);

// Acordeón por categoría: "Todos" abre por defecto mostrando las 12 notas
// juntas; cada categoría es su propio encabezado clickeable que revela sus
// artículos (foto + descripción breve) justo debajo, sin panel flotante ni
// grilla separada que haya que filtrar. Antes esto era una fila de 6
// pastillas que se desbordaba en móvil y, como desplegable único, no
// aprovechaba el ancho en escritorio.
const acordeon = [
  { cat: "Todos", items: temasOrdenados, abierto: true },
  ...grupos.map((g) => ({ cat: g.cat, items: g.items, abierto: false })),
];
---

<section id="conocelo" class="conocelo">
  <div class="conocelo-inner">
    <SectionHead
      eyebrow="Ciencia"
      title="Conócelo."
      lead="12 notas sobre la ciencia real del lulo, con fuente citada y sin promesas de más."
    />

    {/* Grid de 2 columnas en escritorio (categoría a la izquierda, sus
       artículos a la derecha en la misma fila) que en móvil colapsa a una
       sola columna, por el simple acomodo automático de CSS Grid: cada
       encabezado y su panel son hijos directos y consecutivos de
       `.conocelo-acordeon`, así que basta cambiar `grid-template-columns`
       por breakpoint para pasar de "una fila por categoría, 2 columnas" a
       "todo apilado en una columna" sin duplicar marcado ni mover nada
       por JS. */}
    <div class="conocelo-acordeon">
      {
        acordeon.map(({ cat, items, abierto }) => {
          const headerId = `conocelo-header-${slug(cat)}`;
          const panelId = `conocelo-panel-${slug(cat)}`;
          return (
            <>
              <button
                type="button"
                id={headerId}
                class="conocelo-item-header"
                data-accordion-trigger
                aria-expanded={abierto ? "true" : "false"}
                aria-controls={panelId}
              >
                <span class="conocelo-item-label">{cat}</span>
                <span class="conocelo-item-count">{items.length}</span>
                <span class="conocelo-item-chevron">
                  <Icon name="chevron-down" size={16} />
                </span>
              </button>
              <div
                id={panelId}
                class="conocelo-item-panel"
                role="region"
                aria-labelledby={headerId}
                hidden={!abierto}
              >
                <div class="conocelo-item-grid">
                  {items.map((t) => {
                    const d = t.data;
                    const tcat = badgeTipo(d.tipo);
                    return (
                      <Card
                        as="a"
                        href={`/conocelo/${t.id}`}
                        elevation="xs"
                        padding="0"
                        class="conocelo-card"
                      >
                        <div class="conocelo-card-photo">
                          <img src={d.imagen} alt={d.alt} loading="lazy" />
                          <span class="conocelo-card-badge">{tcat}</span>
                        </div>
                        <div class="conocelo-card-body">
                          <h3>{d.title}</h3>
                          <p class="conocelo-card-desc">{d.foco}</p>
                          <span class="conocelo-card-cta">
                            Leer <Icon name="arrow-right" size={13} />
                          </span>
                        </div>
                      </Card>
                    );
                  })}
                </div>
              </div>
            </>
          );
        })
      }
    </div>

    <p class="conocelo-nota">
      Estas notas describen ciencia nutricional y hábitos cotidianos. No
      diagnostican, no tratan ni curan condiciones, y no sustituyen la
      orientación de un profesional de la salud.
    </p>
  </div>
</section>

<style>
  .conocelo {
    scroll-margin-top: 72px;
  }
  .conocelo-inner {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--section-y) var(--gutter-page);
  }

  .conocelo-acordeon {
    display: grid;
    grid-template-columns: 1fr;
    row-gap: var(--space-2);
    margin-bottom: var(--space-6);
  }

  .conocelo-item-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-default);
    background: var(--surface-card);
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    color: var(--text-strong);
    cursor: pointer;
    transition: var(--transition-base);
  }
  .conocelo-item-header:hover {
    background: var(--cream-200);
  }
  .conocelo-item-header[aria-expanded="true"] {
    background: var(--brand-tint);
    border-color: var(--brand);
  }
  .conocelo-item-label {
    flex: 1;
    text-align: left;
  }
  .conocelo-item-count {
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    opacity: 0.65;
  }
  .conocelo-item-chevron {
    display: inline-flex;
    transition: var(--transition-base);
  }
  .conocelo-item-header[aria-expanded="true"] .conocelo-item-chevron {
    transform: rotate(180deg);
  }

  .conocelo-item-panel {
    padding: var(--space-2) 0 var(--space-4);
  }
  .conocelo-item-panel[hidden] {
    display: none;
  }
  .conocelo-item-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: var(--space-4);
  }

  .conocelo-card {
    overflow: hidden;
    gap: 0;
    transition: var(--transition-base);
  }
  .conocelo-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .conocelo-card-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--border-hairline);
    border-width: 0 0 1px 0;
    overflow: hidden;
    background: var(--gradient-lulo);
  }
  .conocelo-card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .conocelo-card-badge {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    background: rgba(31, 43, 26, 0.55);
    color: #fff;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: var(--radius-pill);
  }
  .conocelo-card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .conocelo-card-body h3 {
    font-family: var(--font-display);
    font-size: var(--fs-subtitle);
    line-height: var(--lh-heading);
    margin: 0;
  }
  .conocelo-card-desc {
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin: 0;
  }
  .conocelo-card-cta {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-link);
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
  }

  .conocelo-nota {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-muted);
    max-width: 70ch;
    margin: 0;
  }

  @media (min-width: 761px) {
    .conocelo-acordeon {
      grid-template-columns: 260px 1fr;
      column-gap: var(--space-6);
      row-gap: var(--space-3);
      align-items: start;
    }
  }
</style>

<script>
  const triggers = Array.from(
    document.querySelectorAll<HTMLButtonElement>("#conocelo [data-accordion-trigger]"),
  );

  function closeAll() {
    triggers.forEach((h) => {
      h.setAttribute("aria-expanded", "false");
      const panel = document.getElementById(h.getAttribute("aria-controls") ?? "");
      if (panel) panel.hidden = true;
    });
  }

  triggers.forEach((header) => {
    header.addEventListener("click", () => {
      const wasOpen = header.getAttribute("aria-expanded") === "true";
      const panel = document.getElementById(header.getAttribute("aria-controls") ?? "");
      closeAll();
      if (!wasOpen) {
        header.setAttribute("aria-expanded", "true");
        if (panel) panel.hidden = false;
      }
    });
  });
</script>
