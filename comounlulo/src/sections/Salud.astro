---
import { getCollection } from "astro:content";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";

const piezasRaw = await getCollection("salud");
const piezas = piezasRaw.sort((a, b) => a.data.order - b.data.order);
---

<section id="salud" class="salud" hidden>
  <div class="salud-inner">
    <button type="button" class="pilar-close" data-pilar-close="salud">
      <Icon name="x" size={14} />
      Ocultar esta sección
    </button>

    <div class="regla-de-oro">
      <span class="eyebrow">Regla editorial</span>
      <p class="regla-quote">
        Composición medida, función reconocida, actividad in vitro, beneficio
        clínico: cuatro niveles distintos.
      </p>
      <p class="regla-nota">
        Cada pieza distingue entre esos cuatro niveles de evidencia y nunca
        salta de los tres primeros al cuarto.
      </p>
    </div>

    <div class="salud-grid">
      {
        piezas.map((p) => {
          const d = p.data;
          return (
            <Card
              elevation="xs"
              padding="0"
              class="salud-card"
              as="a"
              href={`/salud/${p.id}`}
            >
              <div class="salud-card-photo">
                {d.imagen ? (
                  <img src={d.imagen} alt={d.alt} loading="lazy" />
                ) : (
                  <span class="salud-card-todo">TODO: {d.conceptoVisual}</span>
                )}
                <span class="salud-card-codigo">{d.codigo}</span>
              </div>
              <div class="salud-card-body">
                <h3>{d.title}</h3>
                <p class="salud-card-desc">{d.enfoque}</p>
                <span class="salud-card-cta">
                  Leer <Icon name="arrow-right" size={13} />
                </span>
              </div>
            </Card>
          );
        })
      }
    </div>

    <p class="salud-nota">
      Estas notas explican ciencia nutricional del lulo con fuente citada.
      No diagnostican, no tratan ni curan condiciones, y no sustituyen la
      orientación de un profesional de la salud.
    </p>
  </div>
</section>

<style>
  .salud {
    background: var(--surface-card);
    border-top: 1px solid var(--border-hairline);
    border-bottom: 1px solid var(--border-hairline);
    scroll-margin-top: 72px;
  }
  .salud-inner {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--section-y) var(--gutter-page);
  }
  .pilar-close {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
    padding: 0;
    margin-bottom: var(--space-8);
    transition: var(--transition-base);
  }
  .pilar-close:hover {
    color: var(--text-strong);
  }

  .regla-de-oro {
    background: var(--cream-200);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    margin-bottom: var(--space-8);
    max-width: 60ch;
  }
  .regla-de-oro .eyebrow {
    display: block;
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--orange-700);
    margin-bottom: var(--space-3);
  }
  .regla-quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-title);
    line-height: var(--lh-heading);
    color: var(--text-strong);
    margin: 0 0 var(--space-3);
  }
  .regla-nota {
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    color: var(--text-muted);
    line-height: var(--lh-body);
    margin: 0;
  }

  .salud-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }
  .salud-card {
    overflow: hidden;
    gap: 0;
    transition: var(--transition-base);
  }
  .salud-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .salud-card-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--border-hairline);
    border-width: 0 0 1px 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--gradient-lulo);
  }
  .salud-card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .salud-card-todo {
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    color: rgba(255, 255, 255, 0.92);
    text-align: center;
    max-width: 26ch;
    padding: var(--space-4);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.25);
  }
  .salud-card-codigo {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    background: rgba(31, 43, 26, 0.55);
    color: #fff;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-eyebrow);
    padding: 4px 9px;
    border-radius: var(--radius-pill);
  }
  .salud-card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .salud-card-body h3 {
    font-family: var(--font-display);
    font-size: var(--fs-subtitle);
    line-height: var(--lh-heading);
    margin: 0;
  }
  .salud-card-desc {
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin: 0;
  }
  .salud-card-cta {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-link);
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
  }

  .salud-nota {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-muted);
    max-width: 70ch;
    margin: 0;
  }

  @media (max-width: 900px) {
    .salud-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .salud-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
