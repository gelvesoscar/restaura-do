---
import { getCollection } from "astro:content";
import SectionHead from "../components/SectionHead.astro";
import Icon from "../components/Icon.astro";
import Tag from "../components/Tag.astro";

const temasRaw = await getCollection("conocerla");
const temas = temasRaw.sort((a, b) => a.data.order - b.data.order);

function badgeTipo(tipo: string) {
  if (tipo.startsWith("Ciencia") || tipo === "Biblioteca viva") return "Ciencia";
  if (tipo.startsWith("Nutrición")) return "Nutrición";
  if (tipo.startsWith("Hábitos")) return "Hábitos";
  if (tipo.startsWith("Mitos")) return "Mitos";
  if (tipo.startsWith("Origen") || tipo.startsWith("Circularidad")) return "Origen";
  return tipo;
}

const CATEGORIAS = ["Ciencia", "Nutrición", "Hábitos", "Mitos", "Origen"];

const grupos = CATEGORIAS.map((cat) => ({
  cat,
  items: temas.filter((t) => badgeTipo(t.data.tipo) === cat),
})).filter((g) => g.items.length > 0);
---

<section id="conocerla" class="conocerla">
  <div class="conocerla-inner">
    <SectionHead
      eyebrow="Ciencia"
      title="Conocerlo."
      lead="12 notas sobre la ciencia real del lulo, con fuente citada y sin promesas de más."
    />

    <div class="conocerla-layout" data-selected="Todos">
      <nav class="conocerla-sidebar" aria-label="Filtrar notas de Conocerla por categoría">
        <Tag category="Todos" selected={true} class="conocerla-sidebar-tag" data-cat-select="Todos">
          <span>Todos</span>
          <span class="conocerla-sidebar-count">{temas.length}</span>
        </Tag>
        {
          grupos.map((g) => (
            <Tag category={g.cat} class="conocerla-sidebar-tag" data-cat-select={g.cat}>
              <span>{g.cat}</span>
              <span class="conocerla-sidebar-count">{g.items.length}</span>
            </Tag>
          ))
        }
      </nav>

      <div class="conocerla-list-panel">
        {
          grupos.map((g) => (
            <div class="conocerla-cat-group" data-cat-panel={g.cat}>
              <button
                type="button"
                class="conocerla-cat-header"
                data-cat-toggle
                aria-expanded="false"
                aria-controls={`conocerla-items-${g.cat}`}
              >
                <span class="conocerla-cat-header-label">{g.cat}</span>
                <span class="conocerla-cat-header-count">{g.items.length}</span>
                <span class="conocerla-chevron">
                  <Icon name="chevron-down" size={16} />
                </span>
              </button>
              <ul class="conocerla-cat-items" id={`conocerla-items-${g.cat}`}>
                {g.items.map((t) => {
                  const d = t.data;
                  return (
                    <li>
                      <a class="conocerla-row" href={`/conocerla/${t.id}`}>
                        <span class="conocerla-row-photo">
                          <img src={d.imagen} alt={d.alt} loading="lazy" />
                        </span>
                        <span class="conocerla-row-body">
                          <span class="conocerla-row-title">{d.title}</span>
                          <span class="conocerla-row-desc">{d.foco}</span>
                        </span>
                        <Icon name="arrow-right" size={14} />
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </div>
    </div>

    <p class="conocerla-nota">
      Estas notas describen ciencia nutricional y hábitos cotidianos. No
      diagnostican, no tratan ni curan condiciones, y no sustituyen la
      orientación de un profesional de la salud.
    </p>
  </div>
</section>

<style>
  .conocerla {
    scroll-margin-top: 72px;
  }
  .conocerla-inner {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--section-y) var(--gutter-page);
  }

  /* Layout: sidebar vertical (escritorio) + panel de listas */
  .conocerla-layout {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--space-6);
    align-items: start;
    margin-bottom: var(--space-8);
  }

  .conocerla-sidebar {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    position: sticky;
    top: 96px;
  }
  :global(.conocerla-sidebar-tag) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    text-align: left;
  }
  .conocerla-sidebar-count {
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    opacity: 0.65;
  }

  .conocerla-list-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .conocerla-cat-group[hidden] {
    display: none;
  }

  .conocerla-cat-header {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    width: 100%;
    background: none;
    border: none;
    padding: 0 0 var(--space-2) 0;
    margin: 0;
    font-family: var(--font-body);
    font-weight: var(--fw-medium);
    font-size: var(--fs-caption);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--orange-700);
    text-align: left;
    cursor: default;
  }
  .conocerla-cat-header-count {
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    color: var(--text-muted);
    text-transform: none;
    letter-spacing: normal;
  }
  .conocerla-chevron {
    display: none;
    margin-left: auto;
    transition: transform 0.2s ease;
  }

  .conocerla-cat-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .conocerla-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-lg);
    background: var(--surface-card);
    text-decoration: none;
    color: inherit;
    transition: var(--transition-base);
  }
  .conocerla-row:hover {
    background: var(--cream-200);
    box-shadow: var(--shadow-sm);
  }
  .conocerla-row-photo {
    width: 56px;
    height: 56px;
    flex: none;
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .conocerla-row-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .conocerla-row-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }
  .conocerla-row-title {
    font-family: var(--font-display);
    font-size: var(--fs-body);
    line-height: var(--lh-heading);
    color: var(--text-strong);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .conocerla-row-desc {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    line-height: var(--lh-body);
    color: var(--text-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .conocerla-nota {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-muted);
    max-width: 70ch;
    margin: 0;
  }

  /* Móvil / tablet angosta: la barra lateral se convierte en acordeón */
  @media (max-width: 900px) {
    .conocerla-layout {
      display: block;
    }
    .conocerla-sidebar {
      display: none;
    }
    .conocerla-cat-header {
      cursor: pointer;
      padding: var(--space-3) 0;
      border-bottom: 1px solid var(--border-hairline);
    }
    .conocerla-chevron {
      display: inline-flex;
    }
    .conocerla-cat-group[data-expanded="true"] .conocerla-chevron {
      transform: rotate(180deg);
    }
    .conocerla-cat-items {
      display: none;
      padding-top: var(--space-3);
    }
    .conocerla-cat-group[data-expanded="true"] .conocerla-cat-items {
      display: flex;
    }
    .conocerla-row-title {
      white-space: normal;
    }
  }
</style>

<script>
  const layout = document.querySelector<HTMLElement>("#conocerla .conocerla-layout");
  const sidebarBtns = document.querySelectorAll<HTMLButtonElement>("#conocerla [data-cat-select]");
  const groups = document.querySelectorAll<HTMLElement>("#conocerla .conocerla-cat-group");

  sidebarBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const selected = btn.dataset.catSelect ?? "Todos";
      sidebarBtns.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      if (layout) layout.dataset.selected = selected;
      groups.forEach((group) => {
        const match = selected === "Todos" || group.dataset.catPanel === selected;
        group.hidden = !match;
      });
    });
  });

  const headers = document.querySelectorAll<HTMLButtonElement>("#conocerla [data-cat-toggle]");
  headers.forEach((header) => {
    header.addEventListener("click", () => {
      const expanded = header.getAttribute("aria-expanded") === "true";
      header.setAttribute("aria-expanded", String(!expanded));
      const group = header.closest<HTMLElement>(".conocerla-cat-group");
      group?.setAttribute("data-expanded", String(!expanded));
    });
  });
</script>
