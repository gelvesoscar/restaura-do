---
import { getCollection } from "astro:content";
import SectionHead from "../components/SectionHead.astro";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";
import Tag from "../components/Tag.astro";

const temasRaw = await getCollection("conocerla");
const temas = temasRaw.sort((a, b) => a.data.order - b.data.order);

function badgeTipo(tipo: string) {
  if (tipo.startsWith("Ciencia") || tipo === "Biblioteca viva") return "Ciencia";
  if (tipo.startsWith("Nutrición")) return "Nutrición";
  if (tipo.startsWith("Hábitos")) return "Hábitos";
  if (tipo.startsWith("Mitos")) return "Mitos";
  if (tipo.startsWith("Origen") || tipo.startsWith("Circularidad")) return "Origen";
  return tipo;
}

const CATEGORIAS = ["Origen", "Mitos", "Ciencia", "Nutrición", "Hábitos"];

const grupos = CATEGORIAS.map((cat) => ({
  cat,
  items: temas.filter((t) => badgeTipo(t.data.tipo) === cat),
})).filter((g) => g.items.length > 0);

// Orden por categoría (Origen, Mitos, Ciencia, Nutrición, Hábitos) para la
// vista "Todos", en vez del orden numérico S01..S12.
const temasOrdenados = grupos.flatMap((g) => g.items);
---

<section id="conocerla" class="conocerla">
  <div class="conocerla-inner">
    <SectionHead
      eyebrow="Ciencia"
      title="Conocerlo."
      lead="12 notas sobre la ciencia real del lulo, con fuente citada y sin promesas de más."
    />

    <div class="conocerla-filtros" role="tablist" aria-label="Filtrar notas de Conocerla por categoría">
      <Tag category="Todos" selected={true} class="conocerla-filtro-tag" data-cat-select="Todos">
        <span>Todos</span>
        <span class="conocerla-filtro-count">{temas.length}</span>
      </Tag>
      {
        grupos.map((g) => (
          <Tag category={g.cat} class="conocerla-filtro-tag" data-cat-select={g.cat}>
            <span>{g.cat}</span>
            <span class="conocerla-filtro-count">{g.items.length}</span>
          </Tag>
        ))
      }
    </div>

    <div class="conocerla-grid">
      {
        temasOrdenados.map((t) => {
          const d = t.data;
          const cat = badgeTipo(d.tipo);
          return (
            <Card
              as="a"
              href={`/conocerla/${t.id}`}
              elevation="xs"
              padding="0"
              class="conocerla-card"
              data-cat-item={cat}
            >
              <div class="conocerla-card-photo">
                <img src={d.imagen} alt={d.alt} loading="lazy" />
                <span class="conocerla-card-badge">{cat}</span>
              </div>
              <div class="conocerla-card-body">
                <h3>{d.title}</h3>
                <p class="conocerla-card-desc">{d.foco}</p>
                <span class="conocerla-card-cta">
                  Leer <Icon name="arrow-right" size={13} />
                </span>
              </div>
            </Card>
          );
        })
      }
    </div>

    <p class="conocerla-nota">
      Estas notas describen ciencia nutricional y hábitos cotidianos. No
      diagnostican, no tratan ni curan condiciones, y no sustituyen la
      orientación de un profesional de la salud.
    </p>
  </div>
</section>

<style>
  .conocerla {
    scroll-margin-top: 72px;
  }
  .conocerla-inner {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--section-y) var(--gutter-page);
  }

  .conocerla-filtros {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
  }
  :global(.conocerla-filtro-tag) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .conocerla-filtro-count {
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    opacity: 0.65;
  }

  .conocerla-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }
  .conocerla-card[hidden] {
    display: none;
  }
  .conocerla-card {
    overflow: hidden;
    gap: 0;
    transition: var(--transition-base);
  }
  .conocerla-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .conocerla-card-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--border-hairline);
    border-width: 0 0 1px 0;
    overflow: hidden;
    background: var(--gradient-lulo);
  }
  .conocerla-card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .conocerla-card-badge {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    background: rgba(31, 43, 26, 0.55);
    color: #fff;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: var(--radius-pill);
  }
  .conocerla-card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .conocerla-card-body h3 {
    font-family: var(--font-display);
    font-size: var(--fs-subtitle);
    line-height: var(--lh-heading);
    margin: 0;
  }
  .conocerla-card-desc {
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin: 0;
  }
  .conocerla-card-cta {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-link);
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
  }

  .conocerla-nota {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-muted);
    max-width: 70ch;
    margin: 0;
  }

  @media (max-width: 900px) {
    .conocerla-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .conocerla-filtros {
      flex-wrap: nowrap;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: var(--space-2);
    }
    .conocerla-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const tagButtons = document.querySelectorAll<HTMLButtonElement>("#conocerla [data-cat-select]");
  const cards = document.querySelectorAll<HTMLElement>("#conocerla .conocerla-card");

  tagButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const selected = btn.dataset.catSelect ?? "Todos";
      tagButtons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      cards.forEach((card) => {
        const match = selected === "Todos" || card.dataset.catItem === selected;
        card.hidden = !match;
      });
    });
  });
</script>
