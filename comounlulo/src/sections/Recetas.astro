---
import { getCollection } from "astro:content";
import SectionHead from "../components/SectionHead.astro";
import Card from "../components/Card.astro";
import Badge from "../components/Badge.astro";
import Icon from "../components/Icon.astro";
import Tag from "../components/Tag.astro";

const recetasRaw = await getCollection("recetas");
const recetas = recetasRaw.sort((a, b) => a.data.order - b.data.order);

const CATEGORIAS = [
  "Todas",
  "Tradición",
  "Bebidas",
  "Postres",
  "Cocina salada",
  "Conservas y salsas",
  "Cócteles",
];

const METODO = [
  "Elegir lulos maduros, aromáticos y firmes con ligera elasticidad; descartar fruta golpeada o fermentada.",
  "Lavar y retirar suavemente la pelusa superficial.",
  "Cortar por la mitad y extraer la pulpa con cuchara.",
  "Para bebidas tradicionales y preparaciones donde importa la textura, macerar con cuchara, molinillo, mortero o manos limpias.",
  "Si se necesita licuar, usar pulsos breves; evitar procesamiento prolongado y colar cuando la receta lo requiera.",
  "Probar antes de endulzar. Ajustar dulzor al final para conservar la identidad ácido-aromática del fruto.",
  "Usar la cáscara como recipiente solo cuando esté íntegra, perfectamente lavada y la presentación lo justifique.",
];
---

<section id="recetas" class="recetas">
  <div class="recetas-inner">
    <SectionHead
      eyebrow="Cocina Como un Lulo"
      title="20 maneras de descubrir una fruta extraordinaria."
      lead="No reunimos todas las recetas con lulo que existen: elegimos veinte que muestran su amplitud, de la tradición vallecaucana a la coctelería, siempre con la misma regla — el lulo debe seguir sabiendo a lulo."
    />

    <div class="metodo">
      <div class="metodo-frase">
        <span class="eyebrow">El Método Como un Lulo</span>
        <p class="metodo-quote">“Antes de la licuadora estaba la mano.”</p>
        <p class="metodo-nota">
          Frase editorial, no un dato arqueológico: describe una preferencia
          técnica documentada — macerar o triturar rústicamente antes que
          licuar a fondo — no una afirmación histórica sobre cómo se
          preparaba el lulo en el pasado.
        </p>
      </div>
      <ol class="metodo-pasos">
        {METODO.map((paso) => <li>{paso}</li>)}
      </ol>
    </div>

    <div class="recetas-filtros" role="group" aria-label="Filtrar por tipo de preparación">
      {
        CATEGORIAS.map((cat, i) => (
          <Tag category={cat} selected={i === 0}>
            {cat}
          </Tag>
        ))
      }
    </div>

    <div class="recetas-grid">
      {
        recetas.map((receta) => {
          const r = receta.data;
          return (
            <Card
              elevation="xs"
              padding="0"
              class="receta-card"
              data-category={r.categoria}
              as="a"
              href={`/recetas/${receta.id}`}
            >
              <div class="receta-card-photo">
                <img src={r.imagen} alt={r.alt} loading="lazy" />
                {r.destacado && (
                  <span class="receta-card-imperdible">
                    <Icon name="star" size={12} color="var(--text-on-brand)" /> Imperdible
                  </span>
                )}
              </div>
              <div class="receta-card-body">
                <div class="receta-card-badges">
                  <Badge tone="neutral">{r.tiempo}</Badge>
                  <Badge tone="neutral">{r.dificultad}</Badge>
                </div>
                <h3>{r.title}</h3>
                <p class="receta-card-desc">{r.seoDescripcion}</p>
                <span class="receta-card-cta">
                  Ver receta <Icon name="arrow-right" size={13} />
                </span>
              </div>
            </Card>
          );
        })
      }
    </div>

    <div class="recetas-comunidad">
      <h3>¿Qué harías tú con un lulo?</h3>
      <p>
        Si tienes una receta propia con lulo, cuéntanosla escribiendo a{" "}
        <a href="mailto:hola@comounlulo.co">hola@comounlulo.co</a>. Las
        mejores pueden sumarse a esta colección.
      </p>
    </div>

    <p class="recetas-nota">
      Cuando una receta se inspira en una fuente externa, se identifica como
      adaptación dentro de su ficha. Antes de preparar cualquier receta con
      pescado, mariscos o alcohol, revisa las notas de seguridad e inocuidad
      indicadas.
    </p>
  </div>
</section>

<style>
  .recetas {
    background: var(--surface-card);
    border-top: 1px solid var(--border-hairline);
    border-bottom: 1px solid var(--border-hairline);
    scroll-margin-top: 72px;
  }
  .recetas-inner {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--section-y) var(--gutter-page);
  }

  .metodo {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: var(--space-8);
    background: var(--cream-200);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    margin-bottom: var(--space-8);
  }
  .metodo-frase {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .metodo-quote {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-title);
    line-height: var(--lh-heading);
    color: var(--text-strong);
    margin: 0;
  }
  .metodo-nota {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-muted);
    line-height: var(--lh-body);
    margin: 0;
  }
  .metodo-pasos {
    margin: 0;
    padding-left: 1.2em;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    color: var(--text-body);
  }

  .recetas-filtros {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .recetas-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    margin-bottom: var(--space-10);
  }
  .receta-card {
    overflow: hidden;
    gap: 0;
    transition: var(--transition-base);
  }
  .receta-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .receta-card[hidden] {
    display: none;
  }
  .receta-card-photo {
    position: relative;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--border-hairline);
    border-width: 0 0 1px 0;
    overflow: hidden;
  }
  .receta-card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .receta-card-imperdible {
    position: absolute;
    top: var(--space-2);
    left: var(--space-2);
    display: inline-flex;
    align-items: center;
    gap: 4px;
    background: var(--brand);
    color: var(--text-on-brand);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    padding: 4px 9px;
    border-radius: var(--radius-pill);
  }
  .receta-card-body {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .receta-card-badges {
    display: flex;
    gap: var(--space-2);
  }
  .receta-card-body h3 {
    font-family: var(--font-display);
    font-size: var(--fs-subtitle);
    line-height: var(--lh-heading);
    margin: 0;
  }
  .receta-card-desc {
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin: 0;
  }
  .receta-card-cta {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-link);
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
  }

  .recetas-comunidad {
    background: var(--gradient-pulpa);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    text-align: center;
    margin-bottom: var(--space-6);
  }
  .recetas-comunidad h3 {
    font-family: var(--font-display);
    font-size: var(--fs-title);
    color: #fff;
    margin: 0 0 var(--space-3);
  }
  .recetas-comunidad p {
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    color: rgba(255, 255, 255, 0.92);
    max-width: 52ch;
    margin: 0 auto;
  }
  .recetas-comunidad a {
    color: #fff;
    text-decoration: underline;
  }

  .recetas-nota {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-muted);
    max-width: 70ch;
    margin: 0;
  }

  @media (max-width: 900px) {
    .metodo {
      grid-template-columns: 1fr;
    }
    .recetas-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 600px) {
    .recetas-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const tags = document.querySelectorAll<HTMLButtonElement>("#recetas [data-tag]");
  const cards = document.querySelectorAll<HTMLElement>("#recetas .receta-card");

  tags.forEach((tag) => {
    tag.addEventListener("click", () => {
      const selected = tag.dataset.tag ?? "Todas";
      tags.forEach((t) => t.setAttribute("aria-pressed", String(t === tag)));
      cards.forEach((card) => {
        const match = selected === "Todas" || card.dataset.category === selected;
        card.hidden = !match;
      });
    });
  });
</script>
