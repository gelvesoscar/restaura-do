---
import Icon from "../components/Icon.astro";

const CAMINOS = [
  {
    id: "cocina",
    icon: "utensils",
    eyebrow: "Cocina",
    titulo: "Saborearla.",
    texto: "20 recetas reales con lulo, de la tradición vallecaucana a la coctelería.",
    cta: "Explorar Cocina",
    foto: "/images/caminos-cocina.webp",
  },
  {
    id: "belleza",
    icon: "sparkles",
    eyebrow: "Belleza",
    titulo: "Cuidarte.",
    texto: "12 conceptos cosméticos responsables, del ritual al I+D, sin inventar beneficios.",
    cta: "Explorar Belleza",
    foto: "/images/caminos-belleza.webp",
  },
  {
    id: "salud",
    icon: "flask-conical",
    eyebrow: "Salud",
    titulo: "Aprovecharla.",
    texto: "Nutrientes, fibra y compuestos bioactivos. Lo que la ciencia ha descubierto del lulo, sin exageraciones ni falsas promesas.",
    cta: "Explorar Salud",
    // No hay una foto de portada dedicada para este pilar (a diferencia de
    // Cocina/Belleza). Mientras el proveedor no entregue una específica,
    // se reutiliza H04 (puesto de mercado con lulos y otras frutas) de las
    // 12 fotos de artículo, por ser una imagen genérica y vistosa.
    foto: "/images/salud/h04-vitamina-c-sin-milagros.webp",
  },
];
---

<section id="caminos" class="caminos">
  <div class="caminos-inner">
    <span class="caminos-eyebrow">Una fruta. Tres formas de descubrirla.</span>
    <div class="caminos-grid">
      {
        CAMINOS.map((c) => (
          <div class="camino-card" data-camino-card={c.id}>
            <div class="camino-foto">
              {c.foto ? (
                <img src={c.foto} alt="" loading="lazy" />
              ) : (
                <span class="camino-foto-todo">TODO: foto de portada — {c.eyebrow}</span>
              )}
              <span class="camino-icon">
                <Icon name={c.icon} size={20} color="var(--orange-700)" />
              </span>
              <span class="camino-activo-badge">
                <Icon name="check" size={12} color="var(--text-on-brand)" />
                Viendo ahora
              </span>
            </div>
            <div class="camino-body">
              <span class="camino-eyebrow">{c.eyebrow}</span>
              <h3>{c.titulo}</h3>
              <p>{c.texto}</p>
              <a href={`#${c.id}`} class="camino-cta" data-pilar-open={c.id}>
                {c.cta} <Icon name="arrow-right" size={13} />
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .caminos-inner {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--section-y) var(--gutter-page);
  }
  .caminos-eyebrow {
    display: block;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--fs-title);
    line-height: var(--lh-heading);
    color: var(--text-strong);
    text-align: center;
    margin-bottom: var(--space-8);
  }
  .caminos-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }
  .camino-card {
    display: flex;
    flex-direction: column;
    background: var(--cream-50);
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 2px solid transparent;
    transition: var(--transition-base);
  }
  .camino-card[data-active="true"] {
    border-color: var(--brand);
    box-shadow: var(--shadow-brand);
  }
  .camino-card[data-active="true"] .camino-cta {
    color: var(--brand-strong);
  }
  .camino-foto {
    position: relative;
    aspect-ratio: 4 / 3;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .camino-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .camino-foto-todo {
    background: var(--gradient-lulo);
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: var(--space-4);
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.25);
  }
  .camino-icon {
    position: absolute;
    bottom: var(--space-4);
    left: var(--space-4);
    width: 40px;
    height: 40px;
    border-radius: var(--radius-pill);
    background: var(--cream-50);
    box-shadow: var(--shadow-md);
    display: grid;
    place-items: center;
  }
  .camino-activo-badge {
    display: none;
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    align-items: center;
    gap: 5px;
    background: var(--brand);
    color: var(--text-on-brand);
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    padding: 6px 10px;
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-sm);
  }
  .camino-card[data-active="true"] .camino-activo-badge {
    display: inline-flex;
  }
  .camino-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
    padding: var(--space-6);
  }
  .camino-body .camino-eyebrow {
    display: block;
    text-align: left;
    font-family: var(--font-body);
    font-style: normal;
    font-size: var(--fs-caption);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--orange-700);
    margin: 0;
    text-shadow: none;
  }
  .camino-card h3 {
    font-family: var(--font-display);
    font-size: var(--fs-subtitle);
    line-height: var(--lh-heading);
    color: var(--text-strong);
    margin: 0;
  }
  .camino-card p {
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin: 0 0 var(--space-2);
  }
  .camino-cta {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    font-weight: var(--fw-medium);
    color: var(--text-link);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    margin-top: auto;
  }
  @media (max-width: 900px) {
    .caminos-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
