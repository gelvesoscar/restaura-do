---
import Icon from "./Icon.astro";
import Input from "./Input.astro";
import Select from "./Select.astro";
import Checkbox from "./Checkbox.astro";
---

<dialog id="bolsa-dialog" class="bolsa-dialog" aria-labelledby="bolsa-title">
  <div class="bolsa-head">
    <div class="bolsa-head-copy">
      <h3 id="bolsa-title">Tu bolsa</h3>
      <p id="bolsa-desc" class="bolsa-desc">Todavía no has agregado nada.</p>
    </div>
    <button id="bolsa-close" type="button" class="bolsa-icon-btn" aria-label="Cerrar">
      <Icon name="x" size={18} />
    </button>
  </div>

  <div id="bolsa-items" class="bolsa-items"></div>

  <form id="bolsa-form" class="bolsa-form" hidden>
    <Input
      label="Correo"
      type="email"
      name="correo"
      placeholder="tu@correo.co"
      hint="Ahí llega la confirmación y el seguimiento."
      required
    />
    <div class="bolsa-form-grid">
      <Select
        label="Ciudad"
        name="ciudad"
        options={["Bogotá", "Medellín", "Cali", "Barranquilla", "Bucaramanga"]}
      />
      <Input label="Dirección" name="direccion" placeholder="Cra 7 # 71-21" required />
    </div>
    <Checkbox
      label="Quiero recibir los tips y recetas nuevas"
      description="Un correo al mes, sin ruido."
      name="newsletter"
      checked
    />
    <div class="bolsa-total">
      <span>Total</span>
      <span class="bolsa-total-todo">TODO — precio pendiente</span>
    </div>
  </form>

  <div class="bolsa-footer">
    <button id="bolsa-seguir" type="button" class="bolsa-btn bolsa-btn-outline" hidden>
      Seguir viendo
    </button>
    <button id="bolsa-confirmar" type="button" class="bolsa-btn bolsa-btn-primary" hidden>
      Confirmar pedido
    </button>
    <button id="bolsa-entendido" type="button" class="bolsa-btn bolsa-btn-primary">
      Entendido
    </button>
  </div>
</dialog>

<style>
  .bolsa-dialog {
    width: 100%;
    max-width: 520px;
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    background: var(--surface-card);
    color: var(--text-body);
  }
  .bolsa-dialog::backdrop {
    background: rgba(31, 43, 26, 0.38);
    backdrop-filter: var(--blur-veil);
    -webkit-backdrop-filter: var(--blur-veil);
  }
  .bolsa-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .bolsa-head-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  #bolsa-title {
    font-family: var(--font-display);
    font-size: var(--fs-title);
    margin: 0;
    color: var(--text-strong);
    line-height: var(--lh-heading);
  }
  .bolsa-desc {
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    color: var(--text-muted);
    line-height: var(--lh-body);
    margin: 0;
  }
  .bolsa-icon-btn {
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-pill);
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-body);
    cursor: pointer;
    transition: var(--transition-base);
    flex: none;
  }
  .bolsa-icon-btn:hover {
    background: var(--cream-200);
  }
  .bolsa-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .bolsa-item {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }
  .bolsa-item-copy {
    display: flex;
    flex-direction: column;
    gap: 2px;
    flex: 1;
  }
  .bolsa-item-name {
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    font-weight: var(--fw-medium);
    color: var(--text-strong);
  }
  .bolsa-item-meta {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-muted);
  }
  .bolsa-item-price {
    font-family: var(--font-body);
    font-size: var(--fs-body-sm);
    color: var(--text-muted);
  }
  .bolsa-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-hairline);
  }
  .bolsa-form-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }
  .bolsa-total {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-body);
    font-size: var(--fs-body);
    font-weight: var(--fw-medium);
    color: var(--text-strong);
  }
  .bolsa-total-todo {
    /* --signal-warn da 2.87:1 sobre cream-50, no alcanza 4.5:1.
       --text-link-hover (naranja-700) da 7:1. */
    color: var(--text-link-hover);
  }
  .bolsa-footer {
    display: flex;
    gap: var(--space-3);
    justify-content: flex-end;
    margin-top: var(--space-2);
  }
  .bolsa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 14px;
    border-radius: var(--radius-pill);
    font: var(--type-button);
    font-size: var(--fs-caption);
    cursor: pointer;
    transition: var(--transition-base);
    border: 1px solid transparent;
  }
  .bolsa-btn-outline {
    background: transparent;
    color: var(--text-strong);
    border-color: var(--border-default);
  }
  .bolsa-btn-outline:hover {
    background: var(--cream-200);
  }
  .bolsa-btn-primary {
    background: var(--brand);
    color: var(--text-on-brand);
    border-color: var(--brand);
  }
  .bolsa-btn-primary:hover {
    background: var(--brand-strong);
    border-color: var(--brand-strong);
  }
  @media (max-width: 560px) {
    .bolsa-form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { getItems, subscribe, clearItems } from "../lib/cart";
  import { confirmarPedido } from "../lib/checkout";

  const dialog = document.getElementById("bolsa-dialog") as HTMLDialogElement;
  const itemsEl = document.getElementById("bolsa-items")!;
  const descEl = document.getElementById("bolsa-desc")!;
  const formEl = document.getElementById("bolsa-form") as HTMLFormElement;
  const seguirBtn = document.getElementById("bolsa-seguir") as HTMLButtonElement;
  const confirmarBtn = document.getElementById("bolsa-confirmar") as HTMLButtonElement;
  const entendidoBtn = document.getElementById("bolsa-entendido") as HTMLButtonElement;
  const closeBtn = document.getElementById("bolsa-close") as HTMLButtonElement;
  const bagCount = document.getElementById("bag-count");

  function render() {
    const items = getItems();
    const hasItems = items.length > 0;

    descEl.textContent = hasItems
      ? "Revisa antes de confirmar. Puedes seguir viendo el sitio."
      : "Todavía no has agregado nada.";

    itemsEl.innerHTML = "";
    items.forEach((item) => {
      const row = document.createElement("div");
      row.className = "bolsa-item";
      const copy = document.createElement("div");
      copy.className = "bolsa-item-copy";
      const name = document.createElement("span");
      name.className = "bolsa-item-name";
      name.textContent = item.nombre;
      const meta = document.createElement("span");
      meta.className = "bolsa-item-meta";
      meta.textContent = `${item.color} · ${item.cantidad} ${item.cantidad > 1 ? "unidades" : "unidad"}`;
      copy.append(name, meta);
      const price = document.createElement("span");
      price.className = "bolsa-item-price";
      price.textContent = "TODO";
      row.append(copy, price);
      itemsEl.appendChild(row);
    });

    formEl.hidden = !hasItems;
    seguirBtn.hidden = !hasItems;
    confirmarBtn.hidden = !hasItems;
    entendidoBtn.hidden = hasItems;

    const count = items.reduce((sum, i) => sum + i.cantidad, 0);
    if (bagCount) {
      bagCount.textContent = String(count);
      bagCount.hidden = count === 0;
    }
  }

  subscribe(render);
  render();

  closeBtn.addEventListener("click", () => dialog.close());
  seguirBtn.addEventListener("click", () => dialog.close());
  entendidoBtn.addEventListener("click", () => dialog.close());

  confirmarBtn.addEventListener("click", async () => {
    const data = new FormData(formEl);
    const correo = String(data.get("correo") ?? "");
    const ciudad = String(data.get("ciudad") ?? "");
    const direccion = String(data.get("direccion") ?? "");
    await confirmarPedido({ items: getItems(), correo, ciudad, direccion });
    clearItems();
    dialog.close();
  });
</script>
