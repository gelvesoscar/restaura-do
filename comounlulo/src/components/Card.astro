---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  tone?: "plain" | "tint" | "pulpa" | "inverse";
  elevation?: "none" | "xs" | "sm" | "md" | "lg";
  padding?: string;
  as?: "div" | "a";
  href?: string;
}

const {
  tone = "plain",
  elevation = "sm",
  padding,
  class: className = "",
  as = "div",
  href,
  ...rest
} = Astro.props;
const Tag = as;
---

<Tag
  href={as === "a" ? href : undefined}
  class={`card card-${tone} ${className}`}
  style={padding ? `padding:${padding};` : undefined}
  data-elevation={elevation}
  {...rest}
>
  <slot />
</Tag>

<style>
  .card {
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    transition: var(--transition-base);
    text-decoration: none;
  }
  .card[hidden] {
    display: none;
  }
  .card-plain {
    background: var(--surface-card);
    border: 1px solid var(--border-hairline);
    color: var(--text-body);
  }
  .card-tint {
    background: var(--brand-tint);
    border: 1px solid var(--brand-soft);
    color: var(--text-body);
  }
  .card-pulpa {
    background: var(--accent-tint);
    border: 1px solid var(--accent-soft);
    color: var(--text-body);
  }
  .card-inverse {
    background: var(--surface-inverse);
    border: 1px solid var(--ink-700);
    color: var(--text-on-inverse);
  }
  .card[data-elevation="none"] {
    box-shadow: none;
  }
  .card[data-elevation="xs"] {
    box-shadow: var(--shadow-xs);
  }
  .card[data-elevation="sm"] {
    box-shadow: var(--shadow-sm);
  }
  .card[data-elevation="md"] {
    box-shadow: var(--shadow-md);
  }
  .card[data-elevation="lg"] {
    box-shadow: var(--shadow-lg);
  }
</style>
