---
import Wordmark from "./Wordmark.astro";
import IconButton from "./IconButton.astro";
import Button from "./Button.astro";
import { NAV_SECCIONES } from "../data/sections";

const links = NAV_SECCIONES.filter(([id]) => id !== "inicio");
---

<header class="nav">
  <div class="nav-inner">
    <a href="/#inicio" class="nav-brand">
      <Wordmark size={22} />
    </a>
    <nav class="nav-links" aria-label="Secciones">
      {
        links.map(([id, label]) => (
          <a href={`/#${id}`} data-nav-link={id} class="nav-link">
            {label}
          </a>
        ))
      }
    </nav>
    <div class="nav-actions">
      <Button href="/#tienda" size="sm" class="nav-cta">Ver la tienda</Button>
      <IconButton
        id="menu-button"
        icon="menu"
        label="Abrir menú"
        class="menu-toggle"
        aria-expanded="false"
        aria-controls="menu-panel"
      />
    </div>
  </div>
  <nav id="menu-panel" class="menu-panel" aria-label="Secciones" hidden>
    <div class="menu-panel-inner">
      {
        links.map(([id, label]) => (
          <a href={`/#${id}`} data-menu-link={id} class="menu-panel-link">
            {label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 30;
    background: var(--veil);
    -webkit-backdrop-filter: var(--blur-veil);
    backdrop-filter: var(--blur-veil);
    border-bottom: 1px solid var(--border-hairline);
  }
  .nav-inner {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: 12px var(--gutter-page);
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }
  .nav-brand {
    border-bottom: none;
    display: flex;
    flex: none;
  }
  /* El listado de secciones (`.nav-links`) vivía siempre visible en el
     header de escritorio, en paralelo al menú hamburguesa de móvil. Con
     más secciones que al principio, esa fila horizontal se sentía
     recargada, así que ahora el hamburguesa es el único menú, en
     cualquier tamaño de pantalla: el header solo deja el wordmark y el
     botón de la tienda, y todo lo demás vive en `.menu-panel`. */
  .nav-links {
    display: none;
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-left: auto;
  }
  .menu-toggle {
    display: inline-flex;
  }
  .menu-panel {
    display: flex;
    justify-content: center;
    padding: 0 var(--gutter-page);
    background: var(--surface-card);
    border-top: 1px solid var(--border-hairline);
    box-shadow: var(--shadow-md);
  }
  .menu-panel[hidden] {
    display: none;
  }
  .menu-panel-inner {
    width: 100%;
    max-width: var(--max-content);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-2) 0 var(--space-5);
  }
  .menu-panel-link {
    font-family: var(--font-body);
    font-size: var(--fs-body);
    color: var(--text-body);
    text-decoration: none;
    border-bottom: none;
    padding: var(--space-3) var(--space-3);
    border-radius: var(--radius-sm);
    transition: var(--transition-base);
  }
  .menu-panel-link:hover {
    background: var(--cream-200);
  }
  .menu-panel-link.is-active {
    color: var(--text-strong);
    background: var(--brand-tint);
  }
  @media (min-width: 761px) {
    .menu-panel-inner {
      flex-direction: row;
      flex-wrap: wrap;
      gap: var(--space-2);
    }
  }
</style>

<script>
  const navLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"),
  );
  const menuLinks = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-menu-link]"),
  );
  const ids = ["inicio", ...navLinks.map((a) => a.dataset.navLink!)];

  function setActive() {
    let current = ids[0];
    for (const id of ids) {
      const el = document.getElementById(id);
      if (el && el.getBoundingClientRect().top <= 140) current = id;
    }
    navLinks.forEach((a) => {
      a.classList.toggle("is-active", a.dataset.navLink === current);
    });
    menuLinks.forEach((a) => {
      a.classList.toggle("is-active", a.dataset.menuLink === current);
    });
  }

  setActive();
  window.addEventListener("scroll", setActive, { passive: true });
  window.addEventListener("resize", setActive);

  // Menú hamburguesa (único menú, en cualquier tamaño de pantalla)
  const menuButton = document.getElementById("menu-button") as HTMLButtonElement | null;
  const menuPanel = document.getElementById("menu-panel") as HTMLElement | null;
  const menuIcon = menuButton?.querySelector("span") as HTMLElement | null;

  function setMenuIcon(name: "menu" | "x") {
    if (!menuIcon) return;
    const url = `https://unpkg.com/lucide-static@0.436.0/icons/${name}.svg`;
    const mask = `url('${url}') center / contain no-repeat`;
    menuIcon.style.setProperty("-webkit-mask", mask);
    menuIcon.style.setProperty("mask", mask);
  }

  function closeMenu() {
    if (!menuButton || !menuPanel) return;
    menuPanel.hidden = true;
    menuButton.setAttribute("aria-expanded", "false");
    menuButton.setAttribute("aria-label", "Abrir menú");
    menuButton.title = "Abrir menú";
    setMenuIcon("menu");
    document.removeEventListener("keydown", onKeydown);
    document.removeEventListener("click", onClickOutside, true);
  }

  function openMenu() {
    if (!menuButton || !menuPanel) return;
    menuPanel.hidden = false;
    menuButton.setAttribute("aria-expanded", "true");
    menuButton.setAttribute("aria-label", "Cerrar menú");
    menuButton.title = "Cerrar menú";
    setMenuIcon("x");
    document.addEventListener("keydown", onKeydown);
    document.addEventListener("click", onClickOutside, true);
  }

  function onKeydown(e: KeyboardEvent) {
    if (e.key === "Escape") {
      closeMenu();
      menuButton?.focus();
    }
  }

  function onClickOutside(e: MouseEvent) {
    const header = menuButton?.closest("header");
    if (header && e.target instanceof Node && !header.contains(e.target)) {
      closeMenu();
    }
  }

  menuButton?.addEventListener("click", () => {
    if (menuPanel?.hidden) openMenu();
    else closeMenu();
  });

  const menuCloseTargets = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("#menu-panel a"),
  );
  menuCloseTargets.forEach((a) => a.addEventListener("click", closeMenu));
</script>
