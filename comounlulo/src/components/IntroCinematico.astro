---
/*
  Intro cinemático: pela la cáscara naranja del lulo para revelar el verde
  de adentro, luego forma el nombre de la marca. Es la misma metáfora del
  manifiesto ("la cáscara cambia desde la pulpa"), pero vista antes de
  leerla.

  Se muestra una sola vez por navegador (localStorage) y respeta
  prefers-reduced-motion. Vive solo en /preview por ahora: no se toca
  Base.astro, así que el resto de páginas del sitio no se ven afectadas.
*/
---

<div id="intro-overlay" class="intro-overlay" hidden>
  <button type="button" id="intro-skip" class="intro-skip">Saltar</button>

  <div class="intro-content">
    <svg
      class="intro-mark"
      viewBox="0 0 64 64"
      width="120"
      height="120"
      role="img"
      aria-label="comounlulo.co"
    >
      <!-- cáscara: círculo naranja completo -->
      <circle cx="32" cy="32" r="30" class="intro-cascara" fill="var(--orange-400)" />
      <!-- pulpa: mitad verde que se "despega" desde el centro -->
      <path
        class="intro-pulpa"
        d="M32 2a30 30 0 0 1 0 60Z"
        fill="var(--green-300)"
      />
      <!-- línea de corte -->
      <path
        class="intro-linea"
        d="M32 6.5A25.5 25.5 0 0 0 32 57.5"
        fill="none"
        stroke="var(--cream-100)"
        stroke-width="2.2"
        stroke-linecap="round"
        pathLength="100"
      />
      <!-- semillas -->
      <g fill="var(--cream-100)">
        <ellipse class="intro-semilla intro-semilla-1" cx="44.2" cy="22.4" rx="3" ry="2" transform="rotate(-28 44.2 22.4)" />
        <ellipse class="intro-semilla intro-semilla-2" cx="48.6" cy="32" rx="3" ry="2" />
        <ellipse class="intro-semilla intro-semilla-3" cx="44.2" cy="41.6" rx="3" ry="2" transform="rotate(28 44.2 41.6)" />
      </g>
    </svg>

    <p class="intro-wordmark">
      comounlulo<em>.co</em>
    </p>
  </div>
</div>

<style>
  .intro-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--cream-50);
    opacity: 0;
    transition: opacity 0.55s ease;
  }
  /*
    Bug real (encontrado en producción): [hidden] por sí solo no alcanza a
    ocultar este overlay. La regla de arriba (.intro-overlay) tiene la misma
    especificidad que el [hidden] que pone el navegador por defecto, y una
    regla de autor le gana a la del navegador aunque el atributo esté
    presente. Sin esto, el overlay se queda display:flex para siempre
    (invisible por opacity:0, pero tapando toda la pantalla) y bloquea
    cualquier clic del sitio, incluida la navegación.
  */
  .intro-overlay[hidden] {
    display: none;
  }
  .intro-overlay.intro-playing {
    opacity: 1;
  }
  .intro-overlay.intro-out {
    opacity: 0;
    pointer-events: none;
  }
  .intro-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
  }
  .intro-mark {
    display: block;
    opacity: 0;
    transform: scale(0.72) rotate(-6deg);
  }
  .intro-playing .intro-mark {
    animation: introMarkIn 0.6s cubic-bezier(0.16, 0.84, 0.32, 1) 0.1s forwards;
  }
  .intro-pulpa {
    transform-origin: 32px 32px;
    transform: scaleX(0);
  }
  .intro-playing .intro-pulpa {
    animation: introPeel 0.6s cubic-bezier(0.16, 0.84, 0.32, 1) 0.55s forwards;
  }
  .intro-linea {
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
  }
  .intro-playing .intro-linea {
    animation: introDraw 0.5s ease 1s forwards;
  }
  .intro-semilla {
    opacity: 0;
  }
  .intro-playing .intro-semilla-1 {
    animation: introFade 0.3s ease 1.15s forwards;
  }
  .intro-playing .intro-semilla-2 {
    animation: introFade 0.3s ease 1.28s forwards;
  }
  .intro-playing .intro-semilla-3 {
    animation: introFade 0.3s ease 1.41s forwards;
  }
  .intro-wordmark {
    font-family: var(--font-display);
    font-size: clamp(24px, 4vw, 32px);
    color: var(--ink-900);
    opacity: 0;
    transform: translateY(8px);
    margin: 0;
  }
  .intro-playing .intro-wordmark {
    animation: introRise 0.5s ease 1.1s forwards;
  }
  .intro-wordmark em {
    font-style: normal;
    color: var(--orange-700);
  }
  .intro-skip {
    position: absolute;
    right: var(--gutter-page);
    bottom: var(--space-8);
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    letter-spacing: var(--ls-eyebrow);
    text-transform: uppercase;
    color: var(--text-muted);
    padding: var(--space-2) var(--space-3);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .intro-playing .intro-skip {
    opacity: 1;
  }
  .intro-skip:hover {
    color: var(--text-strong);
  }

  @keyframes introMarkIn {
    to {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }
  @keyframes introPeel {
    to {
      transform: scaleX(1);
    }
  }
  @keyframes introDraw {
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes introFade {
    to {
      opacity: 1;
    }
  }
  @keyframes introRise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .intro-mark,
    .intro-pulpa,
    .intro-linea,
    .intro-semilla,
    .intro-wordmark,
    .intro-skip {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
      stroke-dashoffset: 0 !important;
    }
  }
</style>

<script is:inline>
  (function () {
    var KEY = "comounlulo_intro_seen";
    var overlay = document.getElementById("intro-overlay");
    if (!overlay) return;

    var reduce = false;
    try {
      reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    } catch (e) {}

    var seen = false;
    try {
      seen = localStorage.getItem(KEY) === "1";
    } catch (e) {}

    if (seen || reduce) return;

    overlay.hidden = false;
    requestAnimationFrame(function () {
      overlay.classList.add("intro-playing");
    });

    var finished = false;
    function finish() {
      if (finished) return;
      finished = true;
      overlay.classList.add("intro-out");
      try {
        localStorage.setItem(KEY, "1");
      } catch (e) {}
      window.setTimeout(function () {
        overlay.hidden = true;
      }, 600);
    }

    overlay.addEventListener("click", finish);
    var skipBtn = document.getElementById("intro-skip");
    if (skipBtn) {
      skipBtn.addEventListener("click", function (e) {
        e.stopPropagation();
        finish();
      });
    }
    window.setTimeout(finish, 2600);
  })();
</script>
