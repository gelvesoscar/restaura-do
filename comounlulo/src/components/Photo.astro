---
interface Props {
  label: string;
  ratio?: string;
  tone?: "lulo" | "pulpa" | "flat";
  radius?: string;
  class?: string;
  src?: string;
}

const {
  label,
  ratio = "4 / 3",
  tone = "lulo",
  radius = "var(--radius-xl)",
  class: className = "",
  src,
} = Astro.props;

const bg =
  tone === "pulpa" ? "var(--gradient-pulpa)" : tone === "flat" ? "var(--cream-200)" : "var(--gradient-lulo)";
---

<div
  class={`photo-slot ${className}`}
  data-tone={tone}
  style={`aspect-ratio:${ratio};background:${src ? "var(--cream-200)" : bg};border-radius:${radius};${src ? "padding:0;" : ""}`}
>
  {
    src ? (
      <img class="photo-real" src={src} alt={label} loading="lazy" />
    ) : (
      <span class="photo-label">TODO: {label}</span>
    )
  }
</div>

<style>
  .photo-slot {
    position: relative;
    border: 1px solid var(--border-hairline);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
  }
  .photo-real {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo-label {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: rgba(255, 255, 255, 0.92);
    text-align: center;
    max-width: 32ch;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.25);
  }
  /* Contraste (Tanda F): sobre tone="flat" (cream-200) el texto blanco da
     1.33:1. text-muted (ink-500) sin sombra da 4.89:1. */
  .photo-slot[data-tone="flat"] .photo-label {
    color: var(--text-muted);
    text-shadow: none;
  }
</style>
