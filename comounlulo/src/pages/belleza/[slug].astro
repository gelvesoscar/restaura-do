---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Badge from "../../components/Badge.astro";

export async function getStaticPaths() {
  const items = await getCollection("belleza");
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const b = item.data;

const seoDescripcion = `${b.foco} ${b.conceptoEditorial}`.slice(0, 155);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: b.title,
  description: seoDescripcion,
  image: `https://comounlulo.co${b.imagen}`,
  articleSection: "Belleza",
  keywords: b.tipo,
};
---

<Base
  title={`${b.title}: comounlulo.co`}
  description={seoDescripcion}
  noindex={true}
  image={jsonLd.image}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  <article class="belleza-articulo">
    <div class="belleza-articulo-inner">
      <a href="/#belleza" class="belleza-back">
        <Icon name="arrow-left" size={14} /> Todos los conceptos de Belleza
      </a>

      <div class="belleza-foto">
        <img src={b.imagen} alt={b.alt} loading="eager" />
        <span class="belleza-codigo">{b.codigo}</span>
      </div>

      <div class="belleza-tags">
        <Badge tone="brand">{b.tipo}</Badge>
      </div>

      <h1>{b.title}</h1>
      <p class="belleza-foco">{b.foco}</p>

      <div class="belleza-concepto">
        <h2>Concepto editorial</h2>
        <p>{b.conceptoEditorial}</p>
      </div>

      <div class="belleza-limite">
        <span class="belleza-limite-label">
          <Icon name="shield-alert" size={16} color="var(--orange-700)" /> Límite y rigor
        </span>
        <p>{b.limiteRigor}</p>
      </div>

      <div class="belleza-sabemos">
        <div class="belleza-sabemos-col">
          <h3>Lo que sabemos</h3>
          <p>
            La cáscara, la pulpa y las semillas del lulo (Solanum quitoense)
            han mostrado actividad antioxidante y antimicrobiana en estudios
            de laboratorio (in vitro).
          </p>
        </div>
        <div class="belleza-sabemos-col">
          <h3>Lo que todavía estamos investigando</h3>
          <p>
            Si esos compuestos, ya formulados en un producto cosmético
            terminado, producen beneficios reales y medibles en la piel o el
            cabello. Potencial bioactivo no es lo mismo que beneficio
            clínico demostrado.
          </p>
        </div>
      </div>

      <p class="belleza-fuente">
        Fuente científica de referencia: Añibarro-Ortega M. et al. (2025).
        <em>
          Nutrients, Phytochemicals, and In Vitro Antioxidant and
          Antimicrobial Activities of Lulo (Solanum quitoense Lam.) Fruit
          Pulp, Peel, and Seeds.
        </em>{" "}
        Foods 14(12):2083. <a href="https://doi.org/10.3390/foods14122083" target="_blank" rel="noopener noreferrer">DOI 10.3390/foods14122083</a>.
      </p>

      <p class="belleza-nota-general">
        No es una colección de remedios caseros: es una exploración
        editorial de cómo la pulpa, la cáscara y la semilla del lulo pueden
        inspirar cosmética contemporánea. Cada concepto se clasifica como
        ritual, inspiración cosmética, producto potencial o I+D, y no debe
        leerse como una promesa de producto disponible hoy.
      </p>
    </div>
  </article>
</Base>

<style>
  .belleza-articulo {
    max-width: var(--max-content);
    margin: 0 auto;
    padding: var(--section-y) var(--gutter-page);
  }
  .belleza-articulo-inner {
    max-width: 68ch;
    margin: 0 auto;
  }
  .belleza-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-link);
    text-decoration: none;
    margin-bottom: var(--space-6);
  }
  .belleza-foto {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border-hairline);
    aspect-ratio: 4 / 3;
    margin-bottom: var(--space-5);
  }
  .belleza-foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .belleza-codigo {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    background: rgba(31, 43, 26, 0.55);
    color: #fff;
    font-family: var(--font-body);
    font-size: var(--fs-micro);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-eyebrow);
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }
  .belleza-tags {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }
  .belleza-articulo h1 {
    font-family: var(--font-display);
    font-size: var(--fs-display-m);
    line-height: var(--lh-heading);
    color: var(--text-strong);
    margin: 0 0 var(--space-3);
  }
  .belleza-foco {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-muted);
    margin: 0 0 var(--space-8);
  }
  .belleza-articulo h2 {
    font-family: var(--font-display);
    font-size: var(--fs-subtitle);
    line-height: var(--lh-heading);
    color: var(--text-strong);
    margin: 0 0 var(--space-3);
  }
  .belleza-concepto {
    margin-bottom: var(--space-6);
  }
  .belleza-concepto p {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin: 0;
  }
  .belleza-limite {
    background: var(--brand-tint);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    margin-bottom: var(--space-6);
  }
  .belleza-limite-label {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    font-weight: var(--fw-medium);
    color: var(--orange-700);
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow);
    margin-bottom: var(--space-2);
  }
  .belleza-limite p {
    margin: 0;
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    color: var(--text-body);
  }
  .belleza-sabemos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    background: var(--cream-200);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-6);
  }
  .belleza-sabemos h3 {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    font-weight: var(--fw-medium);
    text-transform: uppercase;
    letter-spacing: var(--ls-eyebrow);
    color: var(--text-muted);
    margin: 0 0 var(--space-2);
  }
  .belleza-sabemos p {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-body);
    color: var(--text-body);
    margin: 0;
  }
  .belleza-fuente {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-muted);
    line-height: var(--lh-body);
    margin: 0 0 var(--space-6);
  }
  .belleza-fuente a {
    color: var(--text-link);
  }
  .belleza-nota-general {
    font-family: var(--font-body);
    font-size: var(--fs-caption);
    color: var(--text-muted);
    line-height: var(--lh-body);
    margin: 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-hairline);
  }
  @media (max-width: 700px) {
    .belleza-articulo h1 {
      font-size: var(--fs-title);
    }
    .belleza-sabemos {
      grid-template-columns: 1fr;
    }
  }
</style>
