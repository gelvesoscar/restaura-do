---
import Base from "../layouts/Base.astro";
---

<Base>
  <section id="inicio" class="stub">
    <div class="stub-inner">
      <p class="eyebrow">Comounlulo.co</p>
      <h1>Nadie necesita reinventarse. Necesita recordar.</h1>
      <p>Contenido real en la Tanda C.</p>
    </div>
  </section>

  <section id="lulo" class="stub stub-card">
    <div class="stub-inner">
      <p class="eyebrow">Contenido informativo</p>
      <h2>Por qué el lulo</h2>
      <p>Contenido real en la Tanda C.</p>
    </div>
  </section>

  <section id="manifiesto" class="stub stub-gradient">
    <div class="stub-inner">
      <p class="eyebrow">En primera persona</p>
      <h2>Verse como un lulo</h2>
      <p>Contenido real en la Tanda C.</p>
    </div>
  </section>

  <section id="tips" class="stub">
    <div class="stub-inner">
      <p class="eyebrow">Contenido informativo</p>
      <h2>Tips de salud</h2>
      <p>Content collection en Markdown — Tanda D.</p>
    </div>
  </section>

  <section id="recetas" class="stub stub-card">
    <div class="stub-inner">
      <p class="eyebrow">Contenido informativo</p>
      <h2>Recetas</h2>
      <p>Content collection en Markdown — Tanda D.</p>
    </div>
  </section>

  <section id="tienda" class="stub">
    <div class="stub-inner">
      <p class="eyebrow">Un solo SKU</p>
      <h2>Tienda</h2>
      <p>Botella inteligente 600 ml — Tanda E.</p>
    </div>
  </section>
</Base>

<style>
  .stub {
    scroll-margin-top: 72px;
    min-height: 70vh;
    display: flex;
    align-items: center;
  }
  .stub-inner {
    max-width: var(--max-content);
    margin: 0 auto;
    width: 100%;
    padding: var(--section-y) var(--gutter-page);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .stub-card {
    background: var(--surface-card);
    border-top: 1px solid var(--border-hairline);
    border-bottom: 1px solid var(--border-hairline);
  }
  .stub-gradient {
    background: var(--gradient-lulo);
  }
  #inicio h1 {
    max-width: 20ch;
  }
</style>
