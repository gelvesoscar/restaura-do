---
import Base from "../layouts/Base.astro";
import Inicio from "../sections/Inicio.astro";
import PorQueLulo from "../sections/PorQueLulo.astro";
import Manifiesto from "../sections/Manifiesto.astro";
import Tips from "../sections/Tips.astro";
import Recetas from "../sections/Recetas.astro";
---

<Base>
  <Inicio />
  <PorQueLulo />
  <Manifiesto />
  <Tips />
  <Recetas />

  <section id="tienda" class="stub">
    <div class="stub-inner">
      <p class="eyebrow">Un solo SKU</p>
      <h2>Tienda</h2>
      <p>Botella inteligente 600 ml — Tanda E.</p>
    </div>
  </section>
</Base>

<style>
  .stub {
    scroll-margin-top: 72px;
    min-height: 70vh;
    display: flex;
    align-items: center;
  }
  .stub-inner {
    max-width: var(--max-content);
    margin: 0 auto;
    width: 100%;
    padding: var(--section-y) var(--gutter-page);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
</style>
