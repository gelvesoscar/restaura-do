---
import Base from "../layouts/Base.astro";
import Inicio from "../sections/Inicio.astro";
import PorQueLulo from "../sections/PorQueLulo.astro";
import Manifiesto from "../sections/Manifiesto.astro";
---

<Base>
  <Inicio />
  <PorQueLulo />
  <Manifiesto />

  <section id="tips" class="stub">
    <div class="stub-inner">
      <p class="eyebrow">Contenido informativo</p>
      <h2>Tips de salud</h2>
      <p>Content collection en Markdown — Tanda D.</p>
    </div>
  </section>

  <section id="recetas" class="stub stub-card">
    <div class="stub-inner">
      <p class="eyebrow">Contenido informativo</p>
      <h2>Recetas</h2>
      <p>Content collection en Markdown — Tanda D.</p>
    </div>
  </section>

  <section id="tienda" class="stub">
    <div class="stub-inner">
      <p class="eyebrow">Un solo SKU</p>
      <h2>Tienda</h2>
      <p>Botella inteligente 600 ml — Tanda E.</p>
    </div>
  </section>
</Base>

<style>
  .stub {
    scroll-margin-top: 72px;
    min-height: 70vh;
    display: flex;
    align-items: center;
  }
  .stub-inner {
    max-width: var(--max-content);
    margin: 0 auto;
    width: 100%;
    padding: var(--section-y) var(--gutter-page);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .stub-card {
    background: var(--surface-card);
    border-top: 1px solid var(--border-hairline);
    border-bottom: 1px solid var(--border-hairline);
  }
</style>
