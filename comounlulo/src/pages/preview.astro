---
import Base from "../layouts/Base.astro";
import IntroCinematico from "../components/IntroCinematico.astro";
import Inicio from "../sections/Inicio.astro";
import PorQueLulo from "../sections/PorQueLulo.astro";
import Manifiesto from "../sections/Manifiesto.astro";
import Fundadores from "../sections/Fundadores.astro";
import TresCaminos from "../sections/TresCaminos.astro";
import Recetas from "../sections/Recetas.astro";
import Belleza from "../sections/Belleza.astro";
import Bienestar from "../sections/Bienestar.astro";
import Tienda from "../sections/Tienda.astro";
import { MOSTRAR_FUNDADORES } from "../data/sections";
---

<!--
  Vista previa temporal mientras el sitio no está listo para salir al
  público en la raíz del dominio (falta precio, pasarela de pago,
  transportadora y fotografía real — ver README). El sitio completo vive
  aquí, en /preview, marcado noindex para que no aparezca en buscadores; la
  raíz (/) muestra un "próximamente" liviano. Cuando esté listo para
  lanzar de verdad, el contenido de este archivo pasa a ser el de
  index.astro y este archivo se retira.

  Estructura por pilares: TresCaminos (intro, "Una fruta. Tres formas de
  descubrirla.") → Cocina (B01-B12) → Belleza (B01-B12) → Bienestar
  (S01-S12), en ese orden. TresCaminos es el acceso directo a esas 3
  secciones (por eso Cocina/Belleza/Bienestar no se repiten en el menú de
  arriba — ver NAV_SECCIONES en src/data/sections.ts). Cada pilar arranca
  colapsado (solo título + frase) para no alargar la página; el visitante
  elige cuál abrir desde TresCaminos, el menú o el botón propio de cada
  sección — solo un pilar queda abierto a la vez (acordeón). Los tips
  genéricos de hábitos (Tips.astro, src/content/tips/) quedan en el repo
  sin ruta pública — no se perdieron, solo se desvincularon al reenfocar
  Bienestar en la ciencia del lulo.

  Fundadores tampoco está en el menú de arriba: arranca oculta y se abre
  con el botón del Manifiesto ("Conócenos, nuestra historia completa"),
  con su propio botón para volver a ocultarla (ver script en
  Fundadores.astro). MOSTRAR_FUNDADORES en src/data/sections.ts sigue
  siendo el apagador total (sección + botón + footer) si se quiere
  quitar del todo, sin borrar el contenido.
-->
<Base noindex={true}>
  <IntroCinematico />
  <Inicio />
  <PorQueLulo />
  <Manifiesto />
  {MOSTRAR_FUNDADORES && <Fundadores />}
  <TresCaminos />
  <Recetas />
  <Belleza />
  <Bienestar />
  <Tienda />
</Base>

<script>
  const PILARES = ["cocina", "belleza", "bienestar"];

  function setPilarOpen(id: string, open: boolean) {
    const toggle = document.querySelector<HTMLButtonElement>(`[data-pilar-toggle="${id}"]`);
    const panel = document.getElementById(`${id}-panel`);
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", String(open));
    panel.hidden = !open;
    const label = toggle.querySelector<HTMLElement>(".pilar-toggle-label");
    if (label) {
      label.textContent = open
        ? (toggle.dataset.labelClose ?? "Ocultar")
        : (toggle.dataset.labelOpen ?? "Ver más");
    }
  }

  function openOnly(id: string) {
    PILARES.forEach((p) => setPilarOpen(p, p === id));
  }

  document.querySelectorAll<HTMLButtonElement>("[data-pilar-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const id = btn.dataset.pilarToggle!;
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      if (isOpen) {
        setPilarOpen(id, false);
      } else {
        openOnly(id);
      }
    });
  });

  function openFromHash() {
    const id = location.hash.replace("#", "");
    if (PILARES.includes(id)) {
      openOnly(id);
    }
  }

  window.addEventListener("hashchange", openFromHash);
  openFromHash();
</script>
