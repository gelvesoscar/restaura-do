---
import "../styles/styles.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Comounlulo.co",
  description = "Vitalidad que se nota por fuera, porque se cuida por dentro.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      html {
        scroll-behavior: smooth;
        scroll-padding-top: 72px;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
