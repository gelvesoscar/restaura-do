---
import "../styles/styles.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  image?: string;
}

const {
  title = "Comounlulo.co",
  description = "Vitalidad que se nota por fuera, porque se cuida por dentro.",
  noindex = false,
  image,
} = Astro.props;

const siteUrl = (Astro.site?.toString() ?? "https://www.comounlulo.co/").replace(/\/$/, "");
const ogImage = image ?? `${siteUrl}/images/lulo-mercado.jpg`;
const canonicalUrl = new URL(Astro.url.pathname, `${siteUrl}/`).toString();

// Se incluye siempre, incluso en páginas noindex: no hace daño mientras el
// sitio está en preview, y así queda listo sin tener que acordarse de
// agregarlo cuando se quite el noindex al salir a producción.
const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Comounlulo.co",
  url: siteUrl,
  logo: `${siteUrl}/favicon.svg`,
  // TODO: confirmar que @comounlulo es la cuenta de Instagram real y activa
  // antes de depender de este dato para algo más que este bloque.
  sameAs: ["https://www.instagram.com/comounlulo"],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="description" content={description} />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Comounlulo.co" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="es_CO" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(organizationJsonLd)} is:inline />

    <style is:global>
      /*
        El design system copiado (styles.css/tokens/) no trae un reset de
        box-sizing. Sin esto, elementos con width:100% + padding se
        desbordan del viewport en pantallas angostas.
      */
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }
      html {
        scroll-behavior: smooth;
        scroll-padding-top: 72px;
      }
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      main {
        flex: 1;
      }
      :root {
        /*
          Corrección de contraste (WCAG AA, Tanda F): --text-on-brand venía en
          #FFFFFF, y blanco sobre var(--brand) (naranja-400) da 2.75:1 — no
          alcanza el 4.5:1 requerido para texto normal. Usamos ink-900 (ya
          existente en la paleta) sobre ese mismo naranja: 5.38:1. No se
          modifica design-system/tokens/colors.css; esto solo redefine el
          alias semántico después de importarlo.
        */
        --text-on-brand: var(--ink-900);
      }
    </style>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
